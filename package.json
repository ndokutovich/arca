{
  "name": "@ndokutovich/arca",
  "version": "0.11.0",
  "description": "A vault for everything Claude Code throws away: session transcripts kept in git and indexed — hybrid search, cross-session topic threads, cross-project entities, and a temporal knowledge graph.",
  "type": "module",
  "main": "mcp-server.js",
  "scripts": {
    "index": "node indexer.js",
    "index:full": "node indexer.js --full",
    "entities": "node build-entities.js",
    "kg": "node build-kg.js",
    "threads": "node build-threads.js",
    "test": "node --test",
    "serve": "node mcp-server.js",
    "threads:map": "node build-thread-map.js",
    "import:claude-ai": "node import-claude-ai.js",
    "restore": "node cli.js restore",
    "install:claude": "node cli.js install",
    "resurrect": "node cli.js resurrect"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "onnxruntime-node": "^1.30.0",
    "sqlite-vec": "^0.1.9"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "memory",
    "mcp",
    "embeddings",
    "sqlite-vec",
    "knowledge-graph",
    "episodic-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndokutovich/arca.git"
  },
  "author": "ndokutovich",
  "bugs": {
    "url": "https://github.com/ndokutovich/arca/issues"
  },
  "homepage": "https://github.com/ndokutovich/arca#readme",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "lib/",
    "hooks/",
    "agent/",
    "command/",
    "skill/",
    "cli.js",
    "mcp-server.js",
    "indexer.js",
    "index-incremental.js",
    "backfill.js",
    "import-claude-ai.js",
    "build-entities.js",
    "build-kg.js",
    "build-threads.js",
    "build-thread-map.js",
    "thread-map.template.html",
    "README.md",
    "LICENSE",
    "!**/*.test.js"
  ],
  "bin": {
    "arca": "cli.js"
  }
}
